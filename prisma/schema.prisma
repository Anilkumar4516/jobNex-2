// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  JOB_SEEKER
  RECRUITER
  ADMIN
}

enum Region {
  GLOBAL
  US
  INDIA
  BANGLADESH
  EUROPE
  APAC
}

enum ExperienceLevel {
  FRESHER
  ONE_TO_TWO
  THREE_TO_FIVE
  FIVE_PLUS
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ONSITE
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  TECHNICAL
  HR
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionStatus {
  PENDING
  ANSWERED
  SKIPPED
}

enum AutoApplyLogStatus {
  MATCHED_AND_APPLIED
  SKIPPED_LOW_SCORE
  DAILY_LIMIT_REACHED
  FAILED_ERROR
}

enum OutreachStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum ChatSender {
  USER
  ASSISTANT
  SYSTEM
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD_DEVOPS
  MACHINE_LEARNING
  SOFT_SKILL
  CERTIFICATION
  TOOL
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

// ----------------------------------------------------
// 1. AUTHENTICATION & MULTI-ROLE RBAC (NextAuth compatible)
// ----------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // Salted hash for credentials auth (null for OAuth)
  image         String?
  role          UserRole  @default(JOB_SEEKER)
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  resumes            Resume[]
  applications       Application[]
  savedJobs          SavedJob[]
  postedJobs         JobPosting[]        @relation("RecruiterJobs")
  interviewSessions  InterviewSession[]
  autoApplyConfig    AutoApplyConfig?
  referralOutreaches ReferralOutreach[]
  chatSessions       ChatSession[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------
// 2. CANDIDATE PROFILE & PRIVACY MANAGEMENT
// ----------------------------------------------------

model Profile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline            String?           // e.g. "Senior Full-Stack Engineer | React & Node.js"
  bio                 String?           @db.Text
  location            String?           // e.g. "San Francisco, CA" or "Bangalore, India"
  primaryRegion       Region            @default(GLOBAL)
  experienceLevel     ExperienceLevel   @default(FRESHER)
  yearsOfExperience   Float             @default(0)
  currentCompany      String?
  currentTitle        String?
  noticePeriodDays    Int?              @default(30)
  expectedSalaryMin   Decimal?          @db.Decimal(12, 2)
  expectedSalaryMax   Decimal?          @db.Decimal(12, 2)
  salaryCurrency      String            @default("USD") // "USD", "INR", "BDT", "EUR"

  // Social & Portfolio links
  website             String?
  githubUrl           String?
  linkedinUrl         String?
  portfolioUrl        String?

  // Granular Privacy Controls (Wireframe Module 10)
  visibility          ProfileVisibility @default(PUBLIC) // PUBLIC to all recruiters vs PRIVATE (only applied companies)
  maskContactInfo     Boolean           @default(false)  // Hide phone, personal email until interview
  maskCurrentEmployer Boolean           @default(false)  // Hide current employer name from recruiters

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  skills              UserSkill[]
  certifications      UserCertification[]

  @@index([primaryRegion])
  @@index([experienceLevel])
  @@index([visibility])
}

model Resume {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String    // e.g. "John_Doe_Software_Engineer.pdf"
  fileUrl       String    // S3 or Cloudflare R2 presigned/public URL
  fileSize      Int       // Size in bytes
  mimeType      String    // "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
  isPrimary     Boolean   @default(false)

  // AI Parsed metadata & raw content
  rawText       String?   @db.Text
  parsedSummary String?   @db.Text
  parsedData    Json?     // Structured JSON: { education: [], workExperience: [], skills: [], projects: [] }

  // Vector embeddings for pgvector semantic job matching
  embedding     Unsupported("vector(1536)")?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  applications  Application[]
  outreaches    ReferralOutreach[]

  @@index([userId])
  @@index([isPrimary])
}

// ----------------------------------------------------
// 3. JOB POSTINGS & VECTOR MATCHING
// ----------------------------------------------------

model JobPosting {
  id                     String          @id @default(cuid())
  recruiterId            String
  recruiter              User            @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)

  title                  String          // e.g. "Senior React Developer"
  slug                   String          @unique
  company                String          // e.g. "Google", "Microsoft", "TCS"
  companyLogoUrl         String?
  companyWebsite         String?
  location               String          // e.g. "Bangalore, India", "Austin, TX", "Remote"
  region                 Region          @default(GLOBAL)
  workplaceType          WorkplaceType   @default(REMOTE)
  experienceLevel        ExperienceLevel @default(THREE_TO_FIVE)
  minExperienceYears     Int             @default(0)
  maxExperienceYears     Int?

  salaryMin              Decimal?        @db.Decimal(12, 2)
  salaryMax              Decimal?        @db.Decimal(12, 2)
  salaryCurrency         String          @default("USD") // "USD", "INR", "BDT", "EUR"
  isSalaryDisclosed      Boolean         @default(true)

  description            String          @db.Text
  requirements           String          @db.Text
  benefits               String?         @db.Text
  requiredCertifications String[]        @default([]) // e.g. ["AWS", "Google Cloud", "PMP"]

  isActive               Boolean         @default(true)
  isFeatured             Boolean         @default(false)
  viewsCount             Int             @default(0)

  // Vector embedding for pgvector hybrid/semantic search
  embedding              Unsupported("vector(1536)")?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relationships
  skills                 JobSkill[]
  applications           Application[]
  savedBy                SavedJob[]
  autoApplyLogs          AutoApplyLog[]

  @@index([region])
  @@index([experienceLevel])
  @@index([isActive])
  @@index([isFeatured])
  @@index([company])
  @@index([createdAt])
}

model SavedJob {
  id        String     @id @default(cuid())
  userId    String
  jobId     String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

// ----------------------------------------------------
// 4. SKILLS, CERTIFICATIONS & COURSE RECOMMENDATIONS
// ----------------------------------------------------

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique // e.g. "React", "Python", "Docker", "Machine Learning"
  slug        String        @unique
  category    SkillCategory @default(FRAMEWORK)
  description String?

  // Relationships
  userSkills   UserSkill[]
  jobSkills    JobSkill[]
  courseSkills CourseSkill[]

  @@index([name])
  @@index([category])
}

model UserSkill {
  id                String   @id @default(cuid())
  profileId         String
  skillId           String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill             Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  masteryPercentage Int      @default(50) // 0 - 100% (Shown as mastery bars in Module 6)
  yearsOfExperience Float    @default(1.0)
  isVerified        Boolean  @default(false) // Verified via AI interview or quiz

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
}

model JobSkill {
  id          String     @id @default(cuid())
  jobId       String
  skillId     String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill       Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  isMandatory Boolean    @default(true)
  weight      Float      @default(1.0) // Importance weight for match algorithm

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

model UserCertification {
  id             String    @id @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String    // e.g. "AWS Certified Solutions Architect", "PMP"
  issuer         String    // e.g. "Amazon Web Services", "PMI", "Google"
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?

  createdAt      DateTime  @default(now())

  @@index([profileId])
}

model Course {
  id            String        @id @default(cuid())
  title         String        // e.g. "Data Visualization with Python"
  description   String        @db.Text
  provider      String        // e.g. "Coursera", "Udemy", "edX", "FreeCodeCamp"
  url           String        // Direct learning affiliate / enrollment link
  imageUrl      String?
  rating        Float         @default(4.5) // e.g. 4.8
  reviewCount   Int           @default(0)
  durationHours Float         // e.g. 12.0 (displayed as "12h")
  level         CourseLevel   @default(INTERMEDIATE)
  isPaid        Boolean       @default(false)
  price         Decimal?      @db.Decimal(8, 2)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  skills        CourseSkill[]

  @@index([provider])
  @@index([rating])
}

model CourseSkill {
  id       String @id @default(cuid())
  courseId String
  skillId  String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([courseId])
  @@index([skillId])
}

// ----------------------------------------------------
// 5. ATS DASHBOARD & APPLICATIONS
// ----------------------------------------------------

model Application {
  id              String                @id @default(cuid())
  jobId           String
  job             JobPosting            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       User                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resumeId        String?
  resume          Resume?               @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status          ApplicationStatus     @default(APPLIED)
  matchScore      Float?                // Algorithmic / Vector match % (e.g. 85.5)
  isAutoApplied   Boolean               @default(false)
  coverLetter     String?               @db.Text
  recruiterNotes  String?               @db.Text

  appliedAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relationships
  timeline        ApplicationTimeline[]

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId])
  @@index([status])
  @@index([appliedAt])
}

model ApplicationTimeline {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  stage         ApplicationStatus
  title         String            // e.g. "Application Submitted", "Interview Scheduled"
  description   String?           @db.Text
  actionBy      String?           // "Candidate", "Recruiter", "System Auto-Apply"
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([createdAt])
}

// ----------------------------------------------------
// 6. AI TECHNICAL & HR INTERVIEW SIMULATOR
// ----------------------------------------------------

model InterviewSession {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole          String              // e.g. "Software Engineer", "Data Scientist"
  type                InterviewType       @default(TECHNICAL) // TECHNICAL or HR
  status              InterviewStatus     @default(IN_PROGRESS)

  totalQuestions      Int                 @default(5)
  currentStep         Int                 @default(1) // "Question 1 of 5"

  overallScore        Float?              // Rubric overall score (0 - 100)
  benchmarkPercentile Float?              // Comparison against platform candidates (e.g. 82.5%)
  summaryFeedback     String?             @db.Text
  strengths           String[]            @default([])
  improvements        String[]            @default([])

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relationships
  questions           InterviewQuestion[]

  @@index([userId])
  @@index([targetRole])
  @@index([status])
}

model InterviewQuestion {
  id                 String           @id @default(cuid())
  sessionId          String
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionIndex      Int              // 1 to 5
  questionText       String           @db.Text // e.g. "Explain the concept of REST API. How does it work?"
  category           String?          // e.g. "System Architecture", "Behavioral", "Core Java"

  candidateAnswer    String?          @db.Text // Text submission
  audioUrl           String?          // Audio file recording if spoken
  status             QuestionStatus   @default(PENDING)

  // Real-time LLM Rubric Grading
  score              Float?           // 0 to 100
  accuracyScore      Float?
  communicationScore Float?
  relevanceScore     Float?
  actionableFeedback String?          @db.Text
  idealAnswerSample  String?          @db.Text

  answeredAt         DateTime?
  createdAt          DateTime         @default(now())

  @@unique([sessionId, questionIndex])
  @@index([sessionId])
}

// ----------------------------------------------------
// 7. AUTOMATED JOB APPLICATION ENGINE (AUTO-APPLY)
// ----------------------------------------------------

model AutoApplyConfig {
  id                   String            @id @default(cuid())
  userId               String            @unique
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  isEnabled            Boolean           @default(false)
  targetRoles          String[]          @default([]) // e.g. ["Software Engineer", "Frontend Developer"]
  preferredRegions     Region[]          @default([INDIA, GLOBAL])
  experienceLevels     ExperienceLevel[] @default([FRESHER, ONE_TO_TWO])
  minMatchPercentage   Int               @default(70) // e.g. Min 70% threshold

  preferredResumeId    String?           // Id of resume to submit
  maxApplicationsDaily Int               @default(15)
  applicationsToday    Int               @default(0)
  lastRunAt            DateTime?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relationships
  logs                 AutoApplyLog[]

  @@index([userId])
  @@index([isEnabled])
}

model AutoApplyLog {
  id              String             @id @default(cuid())
  configId        String
  config          AutoApplyConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobPosting         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  computedMatch   Float              // Percentage computed by algorithm/AI
  status          AutoApplyLogStatus
  failureReason   String?
  processedAt     DateTime           @default(now())

  @@index([configId])
  @@index([jobId])
  @@index([processedAt])
}

// ----------------------------------------------------
// 8. AUTOMATED COLD REFERRAL OUTREACH TOOL
// ----------------------------------------------------

model ReferralOutreach {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String?
  resume         Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  company        String         // e.g. "Google", "Amazon"
  recipientEmail String         // e.g. "hiring@google.com" or referral employee email
  recipientName  String?
  targetRole     String         // e.g. "Software Engineer"
  subject        String         // e.g. "Referral for Software Engineer Position"
  emailBody      String         @db.Text // AI-generated personalized pitch

  status         OutreachStatus @default(DRAFT)
  bullJobId      String?        // BullMQ tracking ID
  sentAt         DateTime?
  errorMessage   String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([company])
  @@index([status])
}

// ----------------------------------------------------
// 9. CONVERSATIONAL AI CAREER CHATBOT
// ----------------------------------------------------

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?       // Optional for guest/anonymous visitors
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Career Consultation")

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String      @id @default(cuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sender         ChatSender  @default(USER)
  content        String      @db.Text
  suggestedChips String[]    @default([]) // e.g. ["Best skills for Data Science?", "Interview tips?"]

  // Actionable deep links returned by LLM (e.g. targeted job links or course links)
  actionLinks    Json?       // [{ title: "Frontend at TCS", url: "/jobs/tcs-frontend", type: "JOB" }]

  createdAt      DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
